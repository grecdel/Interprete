{
  "name": "interprete",
  "version": "0.7.0",
  "private": true,
  "description": "Assistant de v\u00e9rification journalistique de bureau",
  "author": "Grec Del",
  "homepage": "https://github.com/grecdel/Interprete",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "test:desktop": "node tests/desktop.test.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist:linux": "electron-builder --linux AppImage rpm tar.gz --publish never",
    "dist:windows": "electron-builder --win portable --x64 --publish never",
    "test:desktop:smoke": "node scripts/test_desktop.cjs"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "pdfjs-dist": "6.5.438",
    "playwright": "1.62.0",
    "tesseract.js": "6.0.1"
  },
  "build": {
    "appId": "fr.interprete.assistant",
    "productName": "Interprete",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "package.json",
      "docs/assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "interprete-backend*"
        ]
      }
    ],
    "artifactName": "Interprete-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "tar.gz"
      ],
      "category": "Utility",
      "synopsis": "Assistant de vérification journalistique",
      "maintainer": "Grec Del (https://github.com/grecdel/Interprete)",
      "vendor": "Interprete",
      "icon": "docs/assets/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "docs/assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "docs/assets/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Interprete transcrit les propos que vous choisissez de faire v\u00e9rifier."
      }
    }
  },
  "desktopName": "Interprete.desktop",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
